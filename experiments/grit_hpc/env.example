export PROJECT_ROOT="/shared/path/Graph-Specialisation-and-Metrics"
export GRIT_DATA_ROOT="/shared/path/grit_datasets"
export GRIT_OUTPUT_ROOT="/shared/path/grit_training_runs"
export GRIT_MANIFEST="/shared/path/grit_manifests/main.jsonl"

# Activate a prebuilt environment. Jobs never run pip install.
export ENV_ACTIVATE="/shared/path/venv/bin/activate"

# Optional: a shared pristine GRIT clone reduces GitHub clone traffic.
export GRIT_SOURCE_REPO="/shared/path/pristine_GRIT"

# Optional concurrency/scratch controls.
export GRIT_MAX_PARALLEL=16
export GRIT_SCRATCH_ROOT="/local/scratch/${USER}/grit_hpc"
