+class GlobalVNode(torch.nn.Module):
+    """Add one virtual node connected to every real node."""
+
+    def __init__(self, dim):
+        super().__init__()
+        self.embedding = torch.nn.Parameter(torch.zeros(1, dim))
+
+    def forward(self, batch):
+        graph_id = batch.batch
+        num_real = batch.x.size(0)
+        num_graphs = int(graph_id.max().item()) + 1
+        device = batch.x.device
+        vnode_id = torch.arange(num_graphs, device=device) + num_real
+        real_id = torch.arange(num_real, device=device)
+        vnode_for_real = vnode_id[graph_id]
+
+        # source->target convention used by GRIT attention.
+        virtual_edges = torch.cat([
+            torch.stack([real_id, vnode_for_real]),
+            torch.stack([vnode_for_real, real_id]),
+            torch.stack([vnode_id, vnode_id]),
+        ], dim=1)
+        virtual_attr = batch.edge_attr.new_zeros(
+            virtual_edges.size(1), batch.edge_attr.size(1)
+        )
+
+        batch.x = torch.cat([
+            batch.x, self.embedding.to(dtype=batch.x.dtype).expand(num_graphs, -1)
+        ], dim=0)
+        batch.batch = torch.cat([
+            graph_id, torch.arange(num_graphs, device=device, dtype=graph_id.dtype)
+        ], dim=0)
+        batch.edge_index = torch.cat([batch.edge_index, virtual_edges], dim=1)
+        batch.edge_attr = torch.cat([batch.edge_attr, virtual_attr], dim=0)
+        batch.real_node_mask = torch.arange(
+            num_real + num_graphs, device=device
+        ) < num_real
+
+        counts = torch.bincount(graph_id, minlength=num_graphs)
+        if batch.get("log_deg", None) is not None:
+            vnode_log_deg = torch.log(counts.to(batch.log_deg.dtype) + 1)
+            batch.log_deg = torch.cat([batch.log_deg.view(-1), vnode_log_deg])
+        if batch.get("deg", None) is not None:
+            batch.deg = torch.cat([batch.deg.view(-1), counts.to(batch.deg.dtype)])
+        return batch
+
